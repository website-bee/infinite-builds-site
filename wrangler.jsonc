{
  // Cloudflare Pages: website (public/) + backend (functions/) + database D1.
  // Chạy thử trên máy:  npx wrangler pages dev   (xem README.md)
  "name": "infinite-builds-site",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": "./public",

  // Database sản phẩm / danh mục / blog / ảnh upload (tên "DB" được code gọi là env.DB)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infinite-builds-db",
      "database_id": "3ece3150-7525-40e3-b135-fac468597e0a"
    }
  ]

  // Bảo vệ Admin: đặt mật khẩu trên Cloudflare (KHÔNG ghi vào file này vì repo có thể Public):
  //   Pages > Settings > Variables and secrets > Add > loại Secret, tên ADMIN_PASSWORD, tối thiểu 10 ký tự.
  // Chưa đặt = trang Admin và mọi API admin đều từ chối.
  // (Nếu sau này dùng Cloudflare Access: thêm "vars": { "ACCESS_TEAM_DOMAIN": "...", "ACCESS_AUD": "..." })
}
